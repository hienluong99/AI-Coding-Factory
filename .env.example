# ========================================================
# AI Coding Factory Environment Configuration Example
# Copy this file to .env and configure your values.
# NEVER commit .env with real secrets to version control.
# ========================================================

# App / Orchestrator Settings
APP_ENV=development
LOG_LEVEL=INFO
ORCHESTRATOR_PORT=8000
ORCHESTRATOR_HOST=0.0.0.0

# LLM / AI Agent API Keys (Keep these private in .env)
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Beads & Task Manager
BEADS_CLI_PATH=bd
BEADS_WORKSPACE=.

# Agent Execution Limits & Safety Guards
MAX_FIX_ATTEMPTS=3
AGENT_TIMEOUT_SECONDS=600
AUTO_CREATE_PR=false

# Git & GitHub Integration
GITHUB_TOKEN=your_github_personal_access_token_here
GIT_AUTHOR_NAME=AI Coding Factory Agent
GIT_AUTHOR_EMAIL=agent@aicodingfactory.local
